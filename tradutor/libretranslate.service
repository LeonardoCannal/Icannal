[Unit]
Description=Tradutor LibreTranslate (ingles -> portugues) do i.cannal
After=network-online.target
# Sob demanda: quem liga e o icannal-tradutor (quando alguem usa os Artigos);
# quando ele desliga por ficar parado, este aqui desliga junto.
StopWhenUnneeded=yes

[Service]
User=cannal
WorkingDirectory=/home/cannal
# So ingles e portugues (menos memoria), so acessivel de dentro do servidor,
# sem a pagina web do tradutor. A porta 5000 (a que o i.cannal usa) fica com
# o icannal-tradutor; o tradutor de verdade escuta na 5001.
ExecStart=/home/cannal/libretranslate-venv/bin/libretranslate --host 127.0.0.1 --port 5001 --load-only en,pt --threads 2 --disable-web-ui
# So diz "pronto" quando ja responde (o primeiro pedido espera por isso)
ExecStartPost=/bin/sh -c 'for i in $(seq 1 280); do curl -sf -o /dev/null http://127.0.0.1:5001/languages && exit 0; sleep 1; done; exit 1'
TimeoutStartSec=300
Restart=on-failure
RestartSec=10
# Se um dia o tradutor exagerar na memoria, ele e reiniciado sozinho
# antes de atrapalhar o site.
MemoryMax=1800M
Nice=5
